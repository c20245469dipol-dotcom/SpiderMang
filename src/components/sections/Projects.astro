---
import spider from '../../images/products/spider.png';
import spiderVitamins from '../../images/products/spider-vitamins.png';
import spiderCage from '../../images/products/spider-cage.png';
---

<section class="section" id="projects">
	<div class="container">
		<p class="eyebrow">Catalog preview</p>
		<h2>Explore the products</h2>
		<p class="section-intro">
			This is a catalog preview only. Product descriptions, prices, and availability
			will be posted once confirmed.
		</p>
		<div class="card-grid product-grid">
			<article class="card product-card">
				<img class="product-image" src={spider.src} alt="Spider" loading="lazy" />
				<h3>Spider</h3>
				<p class="product-status">Details coming soon</p>
			</article>
			<article class="card product-card">
				<img class="product-image" src={spiderVitamins.src} alt="Spider vitamins" loading="lazy" />
				<h3>Spider GLoad</h3>
				<p class="product-status">Details coming soon</p>
			</article>
			<article class="card product-card">
				<img class="product-image" src={spiderCage.src} alt="Spider cage" loading="lazy" />
				<h3>Spider Case</h3>
				<p class="product-status">Details coming soon</p>
			</article>
		</div>
	</div>
</section>