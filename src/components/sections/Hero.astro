---
import spiderBackground from '../../images/spider-background.png';
import aboutPhoto from '../../images/about-photo.jpg';
---

	
<section class="hero section" id="hero">
	<svg class="hero-art" viewBox="0 0 500 500" aria-hidden="true" focusable="false">
		<g class="web-lines" fill="none" stroke="currentColor" stroke-width="2">
			<circle cx="330" cy="145" r="52" />
			<circle cx="330" cy="145" r="104" />
			<circle cx="330" cy="145" r="156" />
			<circle cx="330" cy="145" r="208" />
			<path
				d="M330 145 500 0M330 145 500 70M330 145 500 180M330 145 470 360M330 145 330 500M330 145 150 460M330 145 0 350M330 145 0 180M330 145 80 0"
			/>
		</g>
		<image
			class="spider-figure"
			href={spiderBackground.src}
			x="240"
			y="75"
			width="180"
			height="140"
			preserveAspectRatio="xMidYMid meet"
		/>
	</svg>
	
	<div class="container hero-content">
		<h1>Welcome to SpiderMang!</h1>
		<p class="hero-copy">
			Explore the SpiderMang Product: Spider, Spider GLoad, and Spider Case.
			Product details, pricing, and availability are coming soon.
		</p>
		<div>
			<figure class="about-photo">
			<img src={aboutPhoto.src} loading="lazy" />
			<figcaption>Preparing for the first catalog</figcaption>
		</figure>
		</div>
		<div class="button-row">
			<a class="button button-primary" href="#projects">Browse products</a>
			<a class="button button-secondary" href="#about">About SpiderMang</a>
		</div>
	</div>
</section>

<style>
	.spider-figure {
		filter: invert(1);
	}

	:global(:root[data-theme='light']) .spider-figure {
		filter: none;
	}
</style>