<section class="section contact-section" id="contact">
	<div class="container contact-panel">
		<p class="eyebrow">Contact</p>
		<h2>Get in touch</h2>
		<p class="contact-intro">
			Have a question about SpiderMang? Enter your message using the form below.
		</p>
		<div class="contact-grid">
			<div class="contact-info">
				<form class="contact-form" aria-describedby="contact-form-status">
					<fieldset>
						<label for="contact-name">Your name</label>
						<input id="contact-name" name="name" autocomplete="name" />

						<label for="contact-email">Your Gmail address</label>
						<input id="contact-email" name="email" type="email" autocomplete="email" />

						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="4"></textarea>

						<button class="button button-primary" type="submit">
							Send message
						</button>
					</fieldset>
				</form>
			</div>
		</div>
	</div>
</section>