<section class="section contact-section" id="contact">
	<div class="container contact-panel">
		<p class="eyebrow">Contact</p>
		<h2>Get in touch</h2>
		<p class="contact-intro">
			Have a question about SpiderMang? Our contact details and message form are
			being prepared for launch.
		</p>
		<div class="contact-grid">
			<div class="contact-details">
				<h3>Contact details</h3>
				<dl>
					<div>
						<dt>Email</dt>
						<dd>Coming soon</dd>
					</div>
					<div>
						<dt>Phone / WhatsApp</dt>
						<dd>Coming soon</dd>
					</div>
				</dl>
			</div>
			<div>
				<h3>Send a message</h3>
				<form class="contact-form" aria-describedby="contact-form-status">
					<fieldset disabled>
						<label for="contact-name">Your name</label>
						<input id="contact-name" name="name" autocomplete="name" />

						<label for="contact-email">Your Gmail address</label>
						<input id="contact-email" name="email" type="email" autocomplete="email" />

						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="4"></textarea>

						<button class="button button-primary" type="submit">Send message</button>
					</fieldset>
				</form>
				<p class="contact-note" id="contact-form-status">
					The form is not active yet. It needs a receiving email address before
					it can send messages.
				</p>
			</div>
		</div>
	</div>
</section>